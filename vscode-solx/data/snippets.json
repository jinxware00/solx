{
  "Function": { "prefix": "fn", "description": "Named function with unannotated parameters", "body": ["fn ${1:name}(${2:argument})", "\t$0", "end"] },
  "Anonymous function": { "prefix": "fn-anon", "description": "Anonymous function value", "body": ["fn(${1:argument})", "\t$0", "end"] },
  "Conditional": { "prefix": "if", "description": "Conditional block", "body": ["if ${1:true} then", "\t$0", "end"] },
  "Conditional with else": { "prefix": "if-else", "description": "Conditional and fallback block", "body": ["if ${1:true} then", "\t$0", "else", "\t-- fallback", "end"] },
  "Numeric loop": { "prefix": "for", "description": "Inclusive numeric loop", "body": ["for ${1:i} = ${2:1}, ${3:10} do", "\t$0", "end"] },
  "Numeric loop with step": { "prefix": "for-step", "description": "Numeric loop with explicit nonzero step", "body": ["for ${1:i} = ${2:10}, ${3:1}, ${4:-1} do", "\t$0", "end"] },
  "While loop": { "prefix": "while", "description": "Loop while the condition is truthy", "body": ["while ${1:false} do", "\t$0", "end"] },
  "Try and catch": { "prefix": "try", "description": "Recover from a runtime error with a structured error object", "body": ["try", "\t$0", "catch ${1:err}", "\tprint(${1:err}.message)", "end"] },
  "Import module": { "prefix": "import", "description": "Explicitly import a standard module", "body": ["import \"${1|math,core,string,list,object|}\"$0"] },
  "Import with alias": { "prefix": "import-as", "description": "Import a module with a local alias", "body": ["import \"${1|math,core,string,list,object|}\" as ${2:module}$0"] },
  "Variable": { "prefix": "var", "description": "Local variable", "body": ["var ${1:name} = ${2:nil}$0"] },
  "Typed variable": { "prefix": "var-typed", "description": "Variable with a runtime-checked annotation", "body": ["var ${1:name}: ${2:Number} = ${3:0}$0"] }
}
